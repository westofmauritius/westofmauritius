# Copy this file to .env.local for local development and fill in what you
# need. Never commit .env.local — it holds secrets. On Cloudflare, set these
# under Workers → westofmauritius → Settings (see TODO_OLIVER.md).

# --- Build-time (Cloudflare: "Build variables") ---------------------------
# Public address of the site, the single source for canonical URLs, sitemap,
# Open Graph, structured data and e-mail links. Defaults to the production
# domain, so only set it for a different address.
# SITE_URL=https://westofmauritius.mu
# Search engines may index only the SITE_URL host; preview addresses
# (workers.dev) are always blocked. "off" blocks everything.
# SEARCH_INDEXING=auto
# French is built but hidden (no switcher, noindex) until this is "true".
# NEXT_PUBLIC_FRENCH_PUBLISHED=false
# Umami analytics (cookie-free). Leave empty to disable analytics.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Keystatic editing on the live site (docs/content-editing.md).
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Runtime secrets (Cloudflare: "Variables and secrets", type Secret) ----
# Neon Postgres connection string. Without it, forms use memory in
# development and say "temporarily unavailable" on the live site.
# DATABASE_URL=postgres://…
# Resend API key and sender (the sender's domain must be verified in Resend).
# RESEND_API_KEY=re_…
# EMAIL_FROM=West of Mauritius <hello@westofmauritius.mu>
# Where new leads and contact messages are sent.
# LEAD_NOTIFY_EMAIL=you@example.com
# Random secret used to hash IP addresses for spam limits.
# IP_HASH_SALT=
# Admin page (/admin): password and a separate random session secret.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# Keystatic GitHub app (docs/content-editing.md).
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=

# --- Development and tests only ------------------------------------------
# Lets a production build (next start) use the in-memory store, for e2e tests.
# ALLOW_MEMORY_STORE=1
