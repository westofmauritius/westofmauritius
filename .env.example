# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds secrets.

# Public URL of the site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The variables below are added in later steps:
# DATABASE_URL=            # Neon Postgres (step 9)
# RESEND_API_KEY=          # Resend e-mail (step 9)
# LEAD_NOTIFY_EMAIL=       # Where new leads are sent (step 9)
# ADMIN_PASSWORD=          # Password for /admin/leads (step 9)

# Keystatic (content editor). Leave unset to edit locally with `npm run dev`.
# See docs/content-editing.md for editing on the live site.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
