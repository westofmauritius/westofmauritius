# Soley environment variables. Copy to .env.local for local development.
# Without the Supabase variables the app runs on an in-memory demo store
# (development only), and e-mails go to the development outbox.

# --- Site -----------------------------------------------------------------
# Public address, no trailing slash. Used for canonical URLs, sitemaps and
# links in e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The owner's WhatsApp number in international format (digits only), for
# the floating WhatsApp button. Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Shown on the contact page and in e-mails.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Supabase (database, magic link sign-in, document storage) ------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode --------------------------------------------------------------
# "true" runs on the in-memory store with demo data even in production
# builds (used by the end-to-end tests). Never set this on the live site.
SOLEY_DEMO_MODE=

# --- Accounts -------------------------------------------------------------
# Comma-separated e-mails that always have admin rights (bootstrap; more
# admins can be added in the `admins` table).
ADMIN_EMAILS=
# Random secret (32+ characters) that signs session cookies in demo mode
# and the tokens in e-mail links. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- E-mail (Resend) --------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Soley <hello@soley.mu>"
EMAIL_FROM=Soley <onboarding@resend.dev>
# Where admin notifications go (new requests, new installer applications).
ADMIN_NOTIFICATION_EMAIL=

# --- Cloudflare Turnstile (bot protection on public forms) ----------------
# Leave empty locally to skip the check. Test keys that always pass:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Plausible (statistics, only after consent) ---------------------------
# The domain registered in Plausible, e.g. soley.mu. Empty = no statistics
# and no consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Scheduled jobs ----------------------------------------------------------
# Secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
